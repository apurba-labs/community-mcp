# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Community data provider
# demo    = bundled synthetic data
# gotihub = controlled GotiHub APIs
DATA_PROVIDER=demo

# Required only when DATA_PROVIDER=gotihub
# Member-scoped credentials are supplied by the authenticated runtime,
# not by a shared environment token.
GOTIHUB_BASE_URL=https://community.example.org
GOTIHUB_ORGANIZATION_SLUG=test-school
GOTIHUB_SERVICE_TOKEN=
GOTIHUB_ORGANIZATION_ID=

# AWS configuration.
REASONING_PROVIDER=deterministic

# Required only when REASONING_PROVIDER=bedrock.
# For local development, authenticate through AWS IAM Identity Center
# or another standard AWS credential provider.
AWS_PROFILE=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

MCP_CAPABILITY_MODE=public
DEMO_LEDGER_ENABLED=false
DEMO_LEDGER_PATH=.local/demo-assistance.sqlite3

# Inbound MCP authentication
# Production requires MCP_AUTH_ENABLED=true.
MCP_HOST=
MCP_PORT=
MCP_AUTH_ENABLED=false
MCP_AUTH_ISSUER_URL=
MCP_AUTH_AUDIENCE=
MCP_AUTH_JWKS_URL=
MCP_AUTH_REQUIRED_SCOPE=community.read

# Streamable HTTP transport security
MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Assistant backend -> authenticated MCP server
SIMULATOR_MCP_URL=
SIMULATOR_MCP_ACCESS_TOKEN=

# Alumni backend -> assistant backend
# Generate a separate high-entropy secret; never commit its value.
# Simulator
SIMULATOR_MCP_URL=
SIMULATOR_MCP_ACCESS_TOKEN=
SIMULATOR_INTERNAL_API_TOKEN=
SIMULATOR_USAGE_DB_PATH=data/simulator_usage.sqlite3
