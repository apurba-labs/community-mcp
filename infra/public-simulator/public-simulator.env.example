APP_ENV=development
DATA_PROVIDER=demo

SIMULATOR_MCP_URL=http://community-demo-mcp:8000/mcp
SIMULATOR_MCP_TOKEN_FILE=/run/mcp-tokens/simulator.jwt
SIMULATOR_USAGE_DB_PATH=/app/data/simulator_usage.sqlite3

BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

AWS_PROFILE=default
AWS_SHARED_CREDENTIALS_FILE=/run/secrets/aws-credentials
AWS_EC2_METADATA_DISABLED=true
AWS_DEFAULT_REGION=us-east-1
