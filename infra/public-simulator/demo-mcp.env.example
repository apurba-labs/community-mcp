APP_ENV=development
DATA_PROVIDER=demo
MCP_CAPABILITY_MODE=public
MCP_AUTH_ENABLED=true
MCP_AUTH_ISSUER_URL=https://mcp.gotihub.com
MCP_AUTH_AUDIENCE=https://mcp.gotihub.com
MCP_AUTH_JWKS_URL=https://mcp.gotihub.com/.well-known/jwks.json
MCP_AUTH_REQUIRED_SCOPE=community.read
DEMO_LEDGER_ENABLED=false
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_ALLOWED_HOSTS=community-demo-mcp:8000,localhost:8000,127.0.0.1:8000
